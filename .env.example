# Copy to .env for local use. On a host, set these as environment variables.

# Port the backend listens on (most hosts set this for you).
PORT=8000

# Folder holding the SQLite database file (satarksetu.db).
# On a host, point this at a persistent disk/volume.
DATA_DIR=./data

# Long random string that turns on the moderator page at /admin.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=

# Secret used to hash voter IPs (so one person can't confirm or flag twice).
# If empty, one is generated and stored in the database.
VOTE_SECRET=

# Set to 1 when running behind a hosting proxy (Render, Railway, Fly.io, Nginx).
TRUST_PROXY=

# Flags needed before a report is hidden for moderator review.
FLAG_THRESHOLD=5

# true = load scripts/003_sample_reports.sql (demo data) on startup.
SEED_SAMPLES=false

# Only needed if the frontend is hosted on a different domain than the API.
CORS_ORIGINS=
